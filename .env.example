# Copy to .env. The defaults work as-is — no database to install, nothing to configure.
#
# Nothing here is a real credential. The bank, its data and these passwords are fictional.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# embedded — a real PostgreSQL 18 server shipped via npm, run from ./.pgdata.
#            Nothing is installed outside this repository. This is the default.
# external — point at your own Postgres with DATABASE_URL_OWNER below.
DATABASE_MODE=embedded

PGDATA_DIR=.pgdata
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=halcyon

# Owner role. Used only by setup, migrations and the seed — never by the running API.
POSTGRES_USER=halcyon_owner
POSTGRES_PASSWORD=halcyon_owner_dev

# Read-only role. Executes every generated query.
# SELECT on the four data tables and nothing else; default_transaction_read_only = on;
# statement_timeout bounds the cost of any single query.
HALCYON_RO_USER=halcyon_ro
HALCYON_RO_PASSWORD=halcyon_ro_dev

# Application role. Writes the audit log and nothing else.
HALCYON_APP_USER=halcyon_app
HALCYON_APP_PASSWORD=halcyon_app_dev

# Only used when DATABASE_MODE=external. Ignored otherwise.
# DATABASE_URL_OWNER=postgres://user:pass@host:5432/halcyon

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# CORS is restricted to exactly this origin.
CLIENT_ORIGIN=http://localhost:5173

# Guard and execution limits.
MAX_QUESTION_LENGTH=500
ROW_LIMIT=1000
STATEMENT_TIMEOUT_MS=5000

# Requests per window per IP against /api/ask.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# ---------------------------------------------------------------------------
# SQL generation
# ---------------------------------------------------------------------------
# mock      — the Question Catalogue answering behind the provider interface,
#             given the cached schema context. This is the default.
# catalogue — the same statements, with the provider call skipped entirely.
#
# A hosted provider is added as a third value and an implementation of
# LlmProvider. Nothing downstream of the generator changes — see ADR-0010.
LLM_PROVIDER=mock
LLM_MODEL=halcyon-sql-mock-1

# ---------------------------------------------------------------------------
# Seed
# ---------------------------------------------------------------------------
# demo (~250k transactions, seconds) | full (~2.9M, matches the architecture note) | test (~5k)
SEED_SCALE=demo

# Fixed, so generated data is identical on every machine.
SEED_RNG=halcyon-2026

# ---------------------------------------------------------------------------
# Client (Vite — only VITE_* names reach the browser)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000
